<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/senceluisalmon/db" VERSION="20260313" COMMENT="Tabla para logs de SENCE">
  <TABLES>
    <TABLE NAME="block_senceluisalmon_log" COMMENT="Registro de actividad SENCE">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="ID del usuario"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="ID del curso"/>
        <FIELD NAME="eventtype" TYPE="char" LENGTH="20" NOTNULL="true" COMMENT="inicio o cierre"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" COMMENT="exito o error"/>
        <FIELD NAME="glosa" TYPE="text" NOTNULL="false" COMMENT="Código de error o mensaje"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
<FIELD NAME="payload" TYPE="text" NOTNULL="false" COMMENT="JSON de datos enviados a SENCE"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>

<TABLE NAME="block_senceluisalmon_groups" COMMENT="Configuración de fechas por grupo">
  <FIELDS>
    <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
    <FIELD NAME="groupid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="ID del grupo Moodle"/>
    <FIELD NAME="fecha_limite" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    <FIELD NAME="codigo_forzado" TYPE="char" LENGTH="50" NOTNULL="false" COMMENT="CodSence forzado para este grupo"/>
  </FIELDS>
  <KEYS>
    <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
    <KEY NAME="groupid" TYPE="unique" FIELDS="groupid"/>
  </KEYS>
</TABLE>

  </TABLES>
</XMLDB>
