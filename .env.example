# ------------------------------------------------------------------
#  Aula Virtual EducaXpert — variables de entorno
#  Copia este archivo a  .env  y ajusta los valores.
#  NUNCA subas tu .env al repositorio (ya está en .gitignore).
# ------------------------------------------------------------------

# URL pública de la plataforma, sin barra final.
MOODLE_WWWROOT=http://localhost:8080

# Ruta ABSOLUTA a moodledata. Debe estar FUERA del árbol del código
# y fuera del docroot. Si se deja vacío, se usa  <carpeta-padre>/moodledata.
MOODLE_DATAROOT=/ruta/absoluta/a/moodledata

# Carpeta de administración (déjala en 'admin' salvo que la hayas renombrado).
MOODLE_ADMIN_DIR=admin

# ---- Base de datos ----
MOODLE_DB_TYPE=mariadb            # mariadb | mysqli | pgsql
MOODLE_DB_HOST=127.0.0.1
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=educaxpert_aula
MOODLE_DB_USER=moodle
MOODLE_DB_PASS=cambia-esta-clave
MOODLE_DB_PREFIX=mdl_
MOODLE_DB_COLLATION=utf8mb4_general_ci

# ---- Entorno / depuración ----
MOODLE_DEBUG=1                    # 1 = modo desarrollador, 0 = producción
MOODLE_DEBUG_DISPLAY=1            # mostrar errores en pantalla (solo dev)
MOODLE_PASSWORD_POLICY=0          # 0 = sin política de contraseñas (dev), 1 = activada
MOODLE_SLASH_ARGUMENTS=0          # 0 = servidor embebido (php -S), 1 = Apache / Nginx
# MOODLE_DIR_PERMISSIONS=0777

# ---- Integración SENCE (Chile) — SECRETOS: rellénalos solo en tu .env ----
SENCE_RUT_OTEC=
SENCE_TOKEN=
